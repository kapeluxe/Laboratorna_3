const int INF = 100000000;
using Matrix = std::vector<std::vector<int>>;

struct FloydResult {
    double totalTimeMs = 0.0;
    std::vector<double> threadTimesMs;
    Matrix dist;
    Matrix next;
};

// ВАЛІДАЦІЯ ВВОДУ

int ReadInt(const std::string& prompt, int minVal, int maxVal) {
    int value;
    while (true) {
        std::cout << prompt;
        if (std::cin >> value && value >= minVal && value <= maxVal) {
            std::cin.ignore((std::numeric_limits<std::streamsize>::max)(), '\n');
            return value;
        }
        std::cout << "Помилка вводу! Введіть ціле число в межах ["
            << minVal << " .. " << maxVal << "].\n";
        std::cin.clear();
        std::cin.ignore((std::numeric_limits<std::streamsize>::max)(), '\n');
    }
}

// ЗАВДАННЯ 1. ОБЧИСЛЕННЯ ПОЛІНОМА (ВАРІАНТ 10, ДОДАТОК 1)

inline double EvalPolyVariant10(double a) {
    double a2 = a * a;
    double a3 = a2 * a;
    double a4 = a2 * a2;
    double a5 = a4 * a;
    return -0.0005 * a5 + 0.01 * a4 - 0.08 * a3 + 0.3 * a2 - 0.7 * a + 1.5;
}

double PolySequential(const std::vector<double>& A, const std::vector<double>& B, std::vector<double>& C) {
    int n = static_cast<int>(A.size());
    (void)B;
    double start = omp_get_wtime();
    for (int i = 0; i < n; ++i) {
        C[i] = EvalPolyVariant10(A[i]);
    }
    double end = omp_get_wtime();
    return (end - start) * 1000.0;
}

double PolyParallel(const std::vector<double>& A, const std::vector<double>& B, std::vector<double>& C, int threads) {
    int n = static_cast<int>(A.size());
    (void)B;
    omp_set_dynamic(0);

    double start = omp_get_wtime();
#pragma omp parallel for num_threads(threads) schedule(static)
    for (int i = 0; i < n; ++i) {
        C[i] = EvalPolyVariant10(A[i]);
    }
    double end = omp_get_wtime();
    return (end - start) * 1000.0;
}

void RunPolyExperiment(int n) {
    std::cout << "\n====================================================================\n";
    std::cout << " ЗАВДАННЯ 1 (ВАРІАНТ 10) | РОЗМІР МАСИВІВ N = " << n << "\n";
    std::cout << "====================================================================\n";

    std::vector<double> A(n), B(n), C_seq(n), C_par4(n), C_par8(n);
    std::mt19937 gen(42);
    std::uniform_real_distribution<double> dist(-10.0, 10.0);

    for (int i = 0; i < n; ++i) {
        A[i] = dist(gen);
        B[i] = dist(gen);
    }

    // прогрів кешу
    PolySequential(A, B, C_seq);

    double tSeq = PolySequential(A, B, C_seq);
    double tPar4 = PolyParallel(A, B, C_par4, 4);
    double tPar8 = PolyParallel(A, B, C_par8, 8);

    bool ok4 = true, ok8 = true;
    for (int i = 0; i < n; ++i) {
        if (std::fabs(C_seq[i] - C_par4[i]) > 1e-12) ok4 = false;
        if (std::fabs(C_seq[i] - C_par8[i]) > 1e-12) ok8 = false;
    }

    std::cout << std::fixed << std::setprecision(4);
    std::cout << std::left << std::setw(28) << "Режим виконання"
        << std::setw(16) << "Час (мс)"
        << std::setw(16) << "Прискорення"
        << "Коректність\n";
    std::cout << "--------------------------------------------------------------------\n";
    std::cout << std::left << std::setw(28) << "Послідовний (1 потік)"
        << std::setw(16) << tSeq << std::setw(16) << "1.00x" << "Базовий\n";
    std::cout << std::left << std::setw(28) << "Паралельний (4 потоки)"
        << std::setw(16) << tPar4
        << std::setw(16) << (std::to_string(tPar4 > 0 ? tSeq / tPar4 : 0.0).substr(0, 4) + "x")
        << (ok4 ? "OK" : "ПОМИЛКА") << "\n";
    std::cout << std::left << std::setw(28) << "Паралельний (8 потоків)"
        << std::setw(16) << tPar8
        << std::setw(16) << (std::to_string(tPar8 > 0 ? tSeq / tPar8 : 0.0).substr(0, 4) + "x")
        << (ok8 ? "OK" : "ПОМИЛКА") << "\n";

    std::cout << "\nКонтрольні значення: C[0] = " << C_seq[0]
        << ", C[1] = " << C_seq[1] << ", C[2] = " << C_seq[2] << "\n";
}

