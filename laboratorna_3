void InputCustomMatrix() {
    int n = ReadInt("Кількість вершин N (2 - 50): ", 2, 50);
    Matrix mat(n, std::vector<int>(n, INF));
    std::cout << "Вводьте рядки через пробіл (для нескінченності пишіть inf):\n";

    for (int i = 0; i < n; ++i) {
        while (true) {
            std::cout << "Рядок " << (i + 1) << ": ";
            std::string line, tok;
            std::getline(std::cin, line);
            std::istringstream iss(line);
            std::vector<std::string> tokens;
            while (iss >> tok) tokens.push_back(tok);

            if (static_cast<int>(tokens.size()) != n) {
                std::cout << "Потрібно рівно " << n << " значень!\n";
                continue;
            }
            bool ok = true;
            for (int j = 0; j < n; ++j) {
                std::string low = tokens[j];
                std::transform(low.begin(), low.end(), low.begin(), ::tolower);
                if (low == "inf" || tokens[j] == "∞") mat[i][j] = INF;
                else {
                    try {
                        size_t idx = 0;
                        int v = std::stoi(tokens[j], &idx);
                        if (idx != tokens[j].size()) throw 1;
                        mat[i][j] = (v >= INF / 2) ? INF : v;
                    }
                    catch (...) {
                        std::cout << "Некоректне число '" << tokens[j] << "'. Повторіть рядок.\n";
                        ok = false; break;
                    }
                }
            }
            if (ok) break;
        }
    }
    RunFloydWorkflow(mat, "Користувацька матриця");
}

Matrix GenerateBenchmarkGraph(int n) {
    Matrix mat(n, std::vector<int>(n, INF));
    std::mt19937 gen(42);
    std::uniform_int_distribution<int> prob(1, 100), w(1, 50);
    for (int i = 0; i < n; ++i) {
        mat[i][i] = 0;
        for (int j = 0; j < n; ++j)
            if (i != j && prob(gen) <= 40) mat[i][j] = w(gen);
    }
    return mat;
}

