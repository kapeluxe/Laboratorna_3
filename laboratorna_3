// ЗАВДАННЯ 2. ПАРАЛЕЛЬНИЙ АЛГОРИТМ ФЛОЙДА-УОРШЕЛЛА (OPENMP)


void PrintCostMatrix(const Matrix& mat) {
    int n = static_cast<int>(mat.size());
    std::cout << "      ";
    for (int j = 0; j < n; ++j) std::cout << "[" << std::setw(2) << (j + 1) << "]  ";
    std::cout << "\n";

    for (int i = 0; i < n; ++i) {
        std::cout << "[" << std::setw(2) << (i + 1) << "]  ";
        for (int j = 0; j < n; ++j) {
            if (mat[i][j] >= INF / 2) std::cout << " inf  ";
            else std::cout << std::setw(4) << mat[i][j] << "  ";
        }
        std::cout << "\n";
    }
}

void PrintNextMatrix(const Matrix& next) {
    int n = static_cast<int>(next.size());
    std::cout << "      ";
    for (int j = 0; j < n; ++j) std::cout << "[" << std::setw(2) << (j + 1) << "]  ";
    std::cout << "\n";

    for (int i = 0; i < n; ++i) {
        std::cout << "[" << std::setw(2) << (i + 1) << "]  ";
        for (int j = 0; j < n; ++j) {
            if (next[i][j] == -1) std::cout << "  -   ";
            else std::cout << std::setw(4) << (next[i][j] + 1) << "  ";
        }
        std::cout << "\n";
    }
}

void InitNext(const Matrix& dist, Matrix& next) {
    int n = static_cast<int>(dist.size());
    next.assign(n, std::vector<int>(n, -1));
    for (int i = 0; i < n; ++i) {
        for (int j = 0; j < n; ++j) {
            if (i == j) next[i][j] = i;
            else if (dist[i][j] < INF) next[i][j] = j;
        }
    }
}

FloydResult FloydSequential(const Matrix& initW) {
    int n = static_cast<int>(initW.size());
    FloydResult res;
    res.dist = initW;
    InitNext(res.dist, res.next);
    res.threadTimesMs.resize(1, 0.0);

    double start = omp_get_wtime();
    for (int k = 0; k < n; ++k) {
        for (int i = 0; i < n; ++i) {
            if (res.dist[i][k] >= INF) continue;
            for (int j = 0; j < n; ++j) {
                if (res.dist[k][j] < INF && res.dist[i][k] + res.dist[k][j] < res.dist[i][j]) {
                    res.dist[i][j] = res.dist[i][k] + res.dist[k][j];
                    res.next[i][j] = res.next[i][k];
                }
            }
        }
    }
    double end = omp_get_wtime();
    res.totalTimeMs = (end - start) * 1000.0;
    res.threadTimesMs[0] = res.totalTimeMs;
    return res;
}

FloydResult FloydParallel(const Matrix& initW, int numThreads) {
    int n = static_cast<int>(initW.size());
    FloydResult res;
    res.dist = initW;
    InitNext(res.dist, res.next);
    res.threadTimesMs.resize(numThreads, 0.0);

    omp_set_dynamic(0);
    double totalStart = omp_get_wtime();

#pragma omp parallel num_threads(numThreads)
    {
        int tid = omp_get_thread_num();
        double tStart = omp_get_wtime();

        for (int k = 0; k < n; ++k) {
#pragma omp for schedule(static)
            for (int i = 0; i < n; ++i) {
                if (res.dist[i][k] >= INF) continue;
                for (int j = 0; j < n; ++j) {
                    if (res.dist[k][j] < INF && res.dist[i][k] + res.dist[k][j] < res.dist[i][j]) {
                        res.dist[i][j] = res.dist[i][k] + res.dist[k][j];
                        res.next[i][j] = res.next[i][k];
                    }
                }
            }
        }

        double tEnd = omp_get_wtime();
        res.threadTimesMs[tid] = (tEnd - tStart) * 1000.0;
    }

    double totalEnd = omp_get_wtime();
    res.totalTimeMs = (totalEnd - totalStart) * 1000.0;
    return res;
}

void SearchPairPath(const Matrix& dist, const Matrix& next) {
    int n = static_cast<int>(dist.size());
    int u = ReadInt("Початкова вершина u (1 - " + std::to_string(n) + "): ", 1, n) - 1;
    int v = ReadInt("Кінцева вершина v (1 - " + std::to_string(n) + "): ", 1, n) - 1;

    if (u == v) {
        std::cout << "Вершини збігаються. Мінімальна відстань = 0.\n";
        return;
    }
    if (dist[u][v] >= INF / 2) {
        std::cout << "Шлях між " << (u + 1) << " та " << (v + 1) << " ВІДСУТНІЙ (INF).\n";
        return;
    }

    std::vector<int> path = { u };
    std::unordered_set<int> visited = { u };
    int curr = u;
    bool cycle = false;

    while (curr != v) {
        curr = next[curr][v];
        if (curr == -1) {
            std::cout << "Помилка відновлення шляху.\n";
            return;
        }
        if (visited.count(curr) && curr != v) {
            cycle = true;
            path.push_back(curr);
            break;
        }
        visited.insert(curr);
        path.push_back(curr);
    }

    std::cout << "\n[МАРШРУТ]: Відстань = " << dist[u][v] << " | Шлях: ";
    for (size_t i = 0; i < path.size(); ++i) {
        std::cout << (path[i] + 1) << (i + 1 < path.size() ? " -> " : "");
    }
    std::cout << "\n";
    if (cycle) std::cout << "[УВАГА] Маршрут проходить через від'ємний цикл!\n";
}

void RunFloydWorkflow(const Matrix& initW, const std::string& title) {
    int n = static_cast<int>(initW.size());
    std::cout << "\n====================================================================\n";
    std::cout << " АЛГОРИТМ ФЛОЙДА-УОРШЕЛЛА: " << title << " (" << n << " вершин)\n";
    std::cout << "====================================================================\n";

    if (n <= 15) {
        std::cout << "\n[Вхідна матриця відстаней W]:\n";
        PrintCostMatrix(initW);
    }

    FloydResult seq = FloydSequential(initW);
    FloydResult par4 = FloydParallel(initW, 4);
    FloydResult par8 = FloydParallel(initW, 8);

    bool ok4 = (seq.dist == par4.dist);
    bool ok8 = (seq.dist == par8.dist);

    std::cout << std::fixed << std::setprecision(4);
    std::cout << "\n[ЗАМІРИ ЧАСУ ВИКОНАННЯ]:\n";
    std::cout << "1. Послідовна версія (основний потік): " << seq.totalTimeMs << " мс (1.00x)\n\n";

    std::cout << "2. Паралельна версія (4 потоки):       " << par4.totalTimeMs << " мс "
        << "(Прискорення: " << std::setprecision(2) << (par4.totalTimeMs > 0 ? seq.totalTimeMs / par4.totalTimeMs : 0.0)
        << "x, Статус: " << (ok4 ? "OK" : "ERR") << ")\n" << std::setprecision(4);
    for (int t = 0; t < 4; ++t) {
        std::cout << "   • Потік " << t << ": " << par4.threadTimesMs[t] << " мс\n";
    }

    std::cout << "\n3. Паралельна версія (8 потоків):      " << par8.totalTimeMs << " мс "
        << "(Прискорення: " << std::setprecision(2) << (par8.totalTimeMs > 0 ? seq.totalTimeMs / par8.totalTimeMs : 0.0)
        << "x, Статус: " << (ok8 ? "OK" : "ERR") << ")\n" << std::setprecision(4);
    for (int t = 0; t < 8; ++t) {
        std::cout << "   • Потік " << t << ": " << par8.threadTimesMs[t] << " мс\n";
    }

    std::vector<int> negCycles;
    for (int i = 0; i < n; ++i) {
        if (seq.dist[i][i] < 0) negCycles.push_back(i + 1);
    }
    if (!negCycles.empty()) {
        std::cout << "\n[УВАГА! ВИЯВЛЕНО ВІД'ЄМНИЙ ЦИКЛ!] Вершини: ";
        for (size_t i = 0; i < negCycles.size(); ++i)
            std::cout << negCycles[i] << (i + 1 < negCycles.size() ? ", " : "\n");
    }

    while (true) {
        std::cout << "\n1. Вивести матриці D (відстаней) та Next (шляхів) для всіх пар\n";
        std::cout << "2. Знайти найкоротший шлях для обраної пари (u -> v)\n";
        std::cout << "0. Назад\n";
        int sub = ReadInt("Вибір: ", 0, 2);
        if (sub == 0) break;
        if (sub == 1) {
            if (n > 20) std::cout << "Матриця завелика для виведення у консоль.\n";
            else {
                std::cout << "\n[МАТРИЦЯ МІНІМАЛЬНИХ ВІДСТАНЕЙ D]:\n";
                PrintCostMatrix(par4.dist);
                std::cout << "\n[МАТРИЦЯ НАСТУПНИХ ПЕРЕХОДІВ NEXT]:\n";
                PrintNextMatrix(par4.next);
            }
        }
        else {
            SearchPairPath(par4.dist, par4.next);
        }
    }
}

